        case 7: {
            return fs7();
        }
        case 9: {
            return fs9();
        }
        case 11: {
            return fs11();
        }
        case 13: {
            return fs13();
        }
        case 15: {
            return fs15();
        }
        case 17: {
            return fs17();
        }
        case 19: {
            return fs19();
        }
        case 21: {
            return fs21();
        }
        case 23: {
            return fs23();
        }
        case 25: {
            return fs25();
        }
        default: {
            return unpack4(rs[0]);
        }
    }
}

fn dimsm(z: u32) -> vec2<u32> {
    let e = u32(max(p.i.w, 0));
    return vec2<u32>(win[z].w + 2u * e, win[z].h + 2u * e);
}

fn atm(z: u32, x: i32, y: i32, d: vec2<u32>) -> u32 {
    let cx = u32(clamp(x, 0, i32(d.x) - 1));
    let cy = u32(clamp(y, 0, i32(d.y) - 1));
    return wbase(z) + cy * p.ww + cx;
}

// Square median of radius MR (1, 2) of packed 8-bit planes (u0, from
// `quant3`), edge clamped; b0..b2 = v / 255 (t1).
@compute @workgroup_size(16, 16)
fn median_fs_q(@builtin(global_invocation_id) id: vec3<u32>) {
    let z = id.z;
    let d = dimsm(z);
    if (id.x >= d.x || id.y >= d.y) {
        return;
    }
    let x = i32(id.x);
    let y = i32(id.y);
    let side = 2 * MR + 1;
    for (var t = 0; t < side * side; t++) {
        rs[t] = u0[atm(z, x + t % side - MR, y + t / side - MR, d)];
    }
    let m = median_n(side * side);
    let i = widx(z, id.x, id.y);
    b0[i] = tabf(t1[m.x]);
    b1[i] = tabf(t1[m.y]);
    b2[i] = tabf(t1[m.z]);
}

// `rank::median` (radius MR) of a packed premultiplied plane: frame copied,
// alpha filtered only when the window isn't opaque (u1[z] != 0).
@compute @workgroup_size(16, 16)
fn median_fs_px(@builtin(global_invocation_id) id: vec3<u32>) {
    let z = id.z;
    let d = dimsm(z);
    if (id.x >= d.x || id.y >= d.y) {
        return;
    }
    let i = widx(z, id.x, id.y);
    let x = i32(id.x);
    let y = i32(id.y);
    if (x < MR || y < MR || x >= i32(d.x) - MR || y >= i32(d.y) - MR) {
        v0[i] = u0[i];
        return;
    }
    let side = 2 * MR + 1;
    for (var t = 0; t < side * side; t++) {
        rs[t] = u0[widx(z, u32(x + t % side - MR), u32(y + t / side - MR))];
    }
    let m = median_n(side * side);
    let a = select(u0[i] >> 24u, m.w, u1[z] != 0u);
    v0[i] = pack4(vec4<u32>(m.xyz, a));
}

// `brush::dir_median` of DN (odd, <= 25) samples on three channels at once
// (u0 packed 8-bit); p.i.y = 1 for "\"; b0..b2 = v / 255 (t1).
@compute @workgroup_size(16, 16)
fn dir_median_fs(@builtin(global_invocation_id) id: vec3<u32>) {
    let z = id.z;
    let d = dimsm(z);
    if (id.x >= d.x || id.y >= d.y) {
        return;
    }
    let r = DN / 2;
    let x = i32(id.x);
    let y = i32(id.y);
    let W = i32(d.x);
    let H = i32(d.y);
    var sx: i32;
    var tmin: i32;
    var tmax: i32;
    if (p.i.y == 1) {
        sx = 1;
        tmin = -min(x, y);
        tmax = min(W - 1 - x, H - 1 - y);
    } else {
        sx = -1;
        tmin = -min(W - 1 - x, y);
        tmax = min(x, H - 1 - y);
    }
    for (var t = 0; t < DN; t++) {
        let tc = clamp(t - r, tmin, tmax);
        rs[t] = u0[widx(z, u32(x + sx * tc), u32(y + tc))];
    }
    let m = median_n(DN);
    let i = widx(z, id.x, id.y);
    b0[i] = tabf(t1[m.x]);
    b1[i] = tabf(t1[m.y]);
    b2[i] = tabf(t1[m.z]);
}
